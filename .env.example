# Copy to .env and adjust. Nested settings use a double-underscore delimiter,
# e.g. POSTGRES__DSN maps to settings.postgres.dsn. Unset auth secrets keep the
# corresponding gate dev-open.

# -- application -------------------------------------------------------------
APP_NAME=madad_fintech_ai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Emit JSON logs (production) vs colourised console (local dev).
LOG_JSON=false

# -- persistence / backends --------------------------------------------------
# memory | postgres   and   memory | redis
PERSISTENCE__BACKEND=memory
PERSISTENCE__CMS_CACHE=memory
# Async driver for the app; Alembic swaps +asyncpg -> +psycopg for migrations.
POSTGRES__DSN=postgresql+asyncpg://madad:change_me@localhost:5432/madad
REDIS__URL=redis://localhost:6379/0

# -- workflow runtime adapters ----------------------------------------------
# memory | redis (sessions/events) ; memory | postgres (checkpointer)
WORKFLOW__SESSION_BACKEND=memory
WORKFLOW__EVENT_BACKEND=memory
WORKFLOW__CHECKPOINT_BACKEND=memory

# -- unified event bus -------------------------------------------------------
# memory | redis (Redis Streams in production)
EVENTS__TRANSPORT=memory

# -- async scheduling (Celery) ----------------------------------------------
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/2

# -- security (all dev-open until set) --------------------------------------
# Admin bearer token (CMS + Operational Visibility panels).
ADMIN_API_TOKEN=
# Service JWT for the public API.
SECURITY__JWT_SECRET=
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_ISSUER=
SECURITY__JWT_AUDIENCE=
# Webhook HMAC (Madad platform callbacks).
SECURITY__WEBHOOK_SECRET=
SECURITY__WEBHOOK_SIGNATURE_HEADER=X-Madad-Signature

# -- MCP transport (Ishan's cluster) -----------------------------------------
# Toggles between InMemoryMCPClient (false → dev/tests use fakes) and
# HttpMCPClient (true → real fastmcp Streamable HTTP transport to the cluster).
MCP__ENABLED=false
# Cluster endpoint. Leave blank in dev; populate in staging/prod.
MCP__ENDPOINT=
# Cluster auth — bearer (UAT) or iam (prod Cloud Run via google-auth ID token).
MCP__AUTH_MODE=bearer
MCP__AUTH_TOKEN=
# IAM-mode audience (Cloud Run service URL). Required when AUTH_MODE=iam.
MCP__IAM_AUDIENCE=
# Streamable HTTP transport version (don't touch unless Ishan upgrades).
MCP__PROTOCOL_VERSION=2024-11-05
# Optional HMAC signing on outbound MCP requests (rarely needed).
MCP__SIGNING_SECRET=
MCP__SIGNING_HEADER=X-MCP-Signature
# Comma-separated CIDR allowlist (informational — gateway typically enforces).
# MCP__IP_ALLOWLIST=10.0.0.0/8
# Retry / idempotency. The default set is populated by the provider from
# Tools.read_only() | Tools.payment_idempotent_writes(); override only to
# disable the safe-retry lane.
MCP__TIMEOUT_SECONDS=30.0
MCP__RETRY_MAX_ATTEMPTS=3
MCP__RETRY_BASE_DELAY_SECONDS=0.5

# Email replies should route back through SendGrid Inbound Parse so the backend
# can forward them to /workflow/inbound. Example UAT:
# COMMUNICATION_EMAIL_REPLY_TO=agent@reply.uat.madadfintech.com
COMMUNICATION_EMAIL_REPLY_TO=

# Subset of webhook events this deployment accepts on the chokepoint.
# Empty → accept all 14 (Phase 1.a + 1.b). Override per-env, e.g. to reject
# Phase 1.b events on the staging Phase 1.a slice.
# SECURITY__WEBHOOK_ALLOWED_EVENT_TYPES=eligibility.updated,documents.completed,...

# -- observability -----------------------------------------------------------
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__SENTRY_DSN=

# -- worker beat intervals (seconds) -----------------------------------------
CELERY__NUDGE_RUN_DUE_SECONDS=60
CELERY__WORKFLOW_RECOVER_SECONDS=300
CELERY__WORKFLOW_TIMEOUT_SWEEP_SECONDS=300
CELERY__STATUS_POLLER_SECONDS=60

# -- docker compose overrides (used by docker/docker-compose.yml) ------------
POSTGRES_PASSWORD=change_me
GRAFANA_PASSWORD=admin
