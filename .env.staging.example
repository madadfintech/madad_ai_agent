# Staging environment template — copy to docker/.env.staging on the staging
# host (or inject via secrets manager) and adjust placeholders. Use
# scripts/staging_smoke_test.py after starting the stack to verify each MCP
# tool seam before flipping inbound webhook traffic.

# -- application -------------------------------------------------------------
APP_ENV=staging
LOG_LEVEL=INFO
LOG_JSON=true

# -- persistence / backends --------------------------------------------------
PERSISTENCE__BACKEND=postgres
PERSISTENCE__CMS_CACHE=redis
POSTGRES__DSN=postgresql+asyncpg://madad:CHANGE_ME@postgres:5432/madad
REDIS__URL=redis://redis:6379/0

# -- workflow runtime adapters ----------------------------------------------
WORKFLOW__SESSION_BACKEND=redis
WORKFLOW__EVENT_BACKEND=redis
WORKFLOW__CHECKPOINT_BACKEND=postgres

# -- unified event bus -------------------------------------------------------
EVENTS__TRANSPORT=redis

# -- async scheduling (Celery) ----------------------------------------------
CELERY__BROKER_URL=redis://redis:6379/1
CELERY__RESULT_BACKEND=redis://redis:6379/2

# -- security ---------------------------------------------------------------
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_TOKEN
SECURITY__JWT_SECRET=CHANGE_ME_JWT_SECRET
SECURITY__WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_KEY
SECURITY__WEBHOOK_SIGNATURE_HEADER=X-Madad-Signature
# Phase 1.a only on staging — reject 1.b events until invoice workflows ship.
SECURITY__WEBHOOK_ALLOWED_EVENT_TYPES=eligibility.updated,documents.completed,prequalification.completed,madad_score.ready,payment.completed,offers.available,offer.accepted,credit_line.activated

# -- MCP transport (UAT) ----------------------------------------------------
# Flip MCP__ENABLED=true ONLY after smoke tests pass. The InMemoryMCPClient
# stays wired until this is true, so the cutover is reversible by a single
# env-flip + container restart.
MCP__ENABLED=true
MCP__ENDPOINT=https://mcp-uat.<INSERT-CLUSTER-HOST>/mcp
MCP__AUTH_MODE=bearer
MCP__AUTH_TOKEN=CHANGE_ME_UAT_BEARER
MCP__PROTOCOL_VERSION=2024-11-05
MCP__TIMEOUT_SECONDS=30.0
MCP__RETRY_MAX_ATTEMPTS=3
MCP__RETRY_BASE_DELAY_SECONDS=0.5

# -- observability ----------------------------------------------------------
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__SENTRY_DSN=CHANGE_ME_SENTRY_DSN_STAGING

# -- worker beat intervals --------------------------------------------------
CELERY__NUDGE_RUN_DUE_SECONDS=60
CELERY__WORKFLOW_RECOVER_SECONDS=300
CELERY__WORKFLOW_TIMEOUT_SWEEP_SECONDS=300
# Polling interval on staging — keep at the default 60s tick; the cadence-
# per-status logic in app.workers.status_poller controls actual per-run rate.
CELERY__STATUS_POLLER_SECONDS=60

# -- docker compose overrides ------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
